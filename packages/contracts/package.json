{
  "name": "@agentrail-sdk/contracts",
  "version": "0.1.1",
  "description": "Shared AgentRail trace and span contracts for SDK, ingestion, and worker packages.",
  "private": false,
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://github.com/marcelaritonang/agentrail#readme",
  "bugs": {
    "url": "https://github.com/marcelaritonang/agentrail/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcelaritonang/agentrail.git",
    "directory": "packages/contracts"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.1.0"
  }
}
