{
  "name": "@agentrail-sdk/cli",
  "version": "0.1.0",
  "description": "AgentRail CLI for local Context Relay setup and diagnostics.",
  "private": false,
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://github.com/marcelaritonang/agentrail#readme",
  "bugs": {
    "url": "https://github.com/marcelaritonang/agentrail/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcelaritonang/agentrail.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "agentrail": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "node ./dist/main.js"
  },
  "dependencies": {
    "@agentrail-sdk/context": "workspace:0.1.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
