# Copy to .env and fill in. NEVER commit the real .env.

# --- AI provider ---
# Leave LLM_PROVIDER=auto. It uses Gemini when GEMINI_API_KEY is set,
# otherwise falls back to the offline mock (so the app always runs).
LLM_PROVIDER=auto
# Get a free key at https://aistudio.google.com/app/apikey (works from Indonesia)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- App ---
# Simple key required by /api/generate and /api/polish (send as X-API-Key header)
API_KEY=dev-key
# SQLite file for the application tracker
DB_PATH=data/apply.db
MAX_INPUT_CHARS=8000
