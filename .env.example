NODE_ENV=development
DATABASE_URL=postgresql://agentrail:agentrail@localhost:5433/agentrail_test
REDIS_URL=redis://localhost:6379
AGENTRAIL_STREAM=agentrail:spans
AGENTRAIL_CONSUMER_GROUP=agentrail-workers
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=agentrail-evidence
S3_ACCESS_KEY_ID=agentrail-local
S3_SECRET_ACCESS_KEY=agentrail-local-secret
API_KEY_PEPPER=replace-with-at-least-32-random-bytes
TRACE_INCOMPLETE_AFTER_MS=900000
INGEST_PORT=3001
