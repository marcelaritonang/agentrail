NODE_ENV=development
POSTGRES_URL=postgresql://agentrail:agentrail@localhost:5432/agentrail
REDIS_URL=redis://localhost:6379
REDIS_STREAM=agentrail:spans
REDIS_CONSUMER_GROUP=agentrail-workers
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_BUCKET=agentrail-evidence
MINIO_ACCESS_KEY=agentrail-local
MINIO_SECRET_KEY=replace-with-local-secret
API_KEY_PEPPER=replace-with-at-least-32-random-bytes
TRACE_INCOMPLETE_AFTER_MS=900000
INGEST_PORT=4318
