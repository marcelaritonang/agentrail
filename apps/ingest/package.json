{
  "name": "@agentrail-sdk/ingest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "bench": "tsx src/benchmark.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/runtime.js"
  },
  "dependencies": {
    "@agentrail-sdk/config": "workspace:*",
    "@agentrail-sdk/contracts": "workspace:*",
    "@agentrail-sdk/db": "workspace:*",
    "@agentrail-sdk/queue": "workspace:*",
    "@aws-sdk/client-sqs": "3.1091.0",
    "@hono/node-server": "^2.0.11",
    "hono": "^4.12.31"
  },
  "devDependencies": {
    "tsx": "^4.21.0"
  }
}
